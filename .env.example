# Optional. "docker compose up --build" works without this file.
# To change a value, copy this file to .env (which git ignores) and edit the copy.

# Port of the API on this machine.
API_PORT=8080

# Port of PostgreSQL on this machine, for database tools and for running the API from source.
# The API run from source expects 5433; see "Develop without the API container" in the README.
DB_PORT=5433

# Password of the local database. Use letters, digits, hyphens and underscores only.
# If you change it after the first start, the old data must go too:
#   docker compose down --volumes
POSTGRES_PASSWORD=carts-local-only
