<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <!-- No culture data anywhere: the code behaves the same on a laptop and in the Alpine image. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Warnings fail the restore and the build in CI (GitHub Actions sets CI=true). That
      includes NuGet's audit of packages with known vulnerabilities (NU1901-NU1904). On any
      other machine they stay warnings, so a newer SDK or a newly published advisory cannot
      break a clean clone. The README shows how to apply the CI rule locally.
    -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <!-- Failing to reach the advisory database is never an error, in CI or anywhere else. -->
    <WarningsNotAsErrors>NU1900;NU1905</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
